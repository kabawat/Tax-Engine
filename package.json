{
  "name": "tax-engine",
  "version": "1.0.0",
  "description": "Zero-configuration multi-country tax calculation SDK (India GST, UAE VAT, US sales tax samples)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./in/schedule": {
      "types": "./dist/in/schedule.d.ts",
      "import": "./dist/in/schedule.js",
      "default": "./dist/in/schedule.js"
    },
    "./rules/india": {
      "types": "./dist/rules/india/index.d.ts",
      "import": "./dist/rules/india/index.js"
    },
    "./rules/usa": {
      "types": "./dist/rules/usa/index.d.ts",
      "import": "./dist/rules/usa/index.js"
    },
    "./rules/uae": {
      "types": "./dist/rules/uae/index.d.ts",
      "import": "./dist/rules/uae/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "manual-test": "npm run build && node examples/manual-test.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "tax",
    "gst",
    "vat",
    "sales-tax",
    "calculation",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
